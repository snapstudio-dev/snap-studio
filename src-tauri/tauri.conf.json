{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap Studio",
  "version": "0.18.0",
  "identifier": "fr.carlini.snapstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Snap Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://cdn.shopify.com thumb: http://thumb.localhost cam: http://cam.localhost prn: http://prn.localhost data: blob:; media-src 'self' prn: http://prn.localhost; connect-src 'self' ipc: http://ipc.localhost mesh: http://mesh.localhost gcode: http://gcode.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://kameka22.github.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "3MF file browser and slicer for the Snapmaker U1",
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "./icons/macos/Assets.car",
        "Resources/en.lproj/InfoPlist.strings": "./locales/en.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "./locales/fr.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "./locales/de.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "./locales/es.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "./locales/pt-BR.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "./locales/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "./locales/ja.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./locales/zh-Hans.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "./locales/ko.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOURBMTgyMjU4NDBFMTYKUldRV0RvUWxncUdkeXczNC9VNURCTUoyZUQ0VDZmYjRYQm9QangyZHoxeFQzMUlyYVZkUXowVHYK",
      "endpoints": [
        "https://github.com/kameka22/snap-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
