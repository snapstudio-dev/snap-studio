<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- English is the development language; translations of the texts below
       live in locales/<lang>.lproj/InfoPlist.strings, copied into the bundle
       by `bundle.macOS.files`. macOS shows them in the system language. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fr</string>
    <string>de</string>
    <string>es</string>
    <string>pt-BR</string>
    <string>it</string>
    <string>ja</string>
    <string>zh-Hans</string>
    <string>ko</string>
  </array>
  <!-- macOS 26 icon: Icon Composer source in icons/macos/AppIcon.icon,
       compiled to icons/macos/Assets.car (scripts/build-icons.py). Older
       systems use icon.icns, on Apple's grid so macOS 26 does not frame it
       in a light tile either. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- Printer discovery (mDNS): without these keys macOS silently blocks the
       search. Merged by Tauri into the bundle's Info.plist. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Snap Studio looks for Snapmaker printers on your local network.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_snapmaker._tcp</string>
    <string>_moonraker._tcp</string>
  </array>
  <!-- Protected folders: text shown in the permission prompt. -->
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Snap Studio shows and prepares the 3D models stored in this folder.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Snap Studio shows and prepares the 3D models stored in this folder.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Snap Studio shows and prepares the 3D models stored in this folder.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Snap Studio shows and prepares the 3D models stored on this disk.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Snap Studio shows and prepares the 3D models stored on this network volume.</string>
</dict>
</plist>
